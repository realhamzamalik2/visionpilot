# ---- Gemini (free tier). Get a key at https://aistudio.google.com/apikey and do NOT add billing ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# ---- MCP server ----
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=8765
MODEL_DIR=./models
MODEL_MEMORY_BUDGET_MB=2500
WARMUP_MODELS=yolo26n,florence2
LOG_LEVEL=INFO

# ---- Agent backend ----
MCP_URL=http://127.0.0.1:8765/mcp
AGENT_MAX_STEPS=8
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
