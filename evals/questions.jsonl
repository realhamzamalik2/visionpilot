{"id": "bus-count", "media": "sample:seoul/street_bus.jpg", "question": "How many people are in this photo?", "expect": {"tools_all": ["detect_objects"], "answer_number": {"min": 4, "max": 4}}}
{"id": "bus-has-bus", "media": "sample:seoul/street_bus.jpg", "question": "Is there a bus in this picture?", "expect": {"tools_any": ["detect_objects", "find_phrase", "describe_image", "segment_objects"], "answer_contains_any": ["yes", "bus"]}}
{"id": "bus-no-dog", "media": "sample:seoul/street_bus.jpg", "question": "Is there a dog in this image?", "expect": {"tools_any": ["detect_objects", "describe_image", "find_phrase"], "answer_contains_any": ["no ", "not", "none", "no dog", "There is no", "There are no"]}}
{"id": "bus-closest", "media": "sample:seoul/street_bus.jpg", "question": "How far away is the closest person?", "expect": {"tools_all": ["detect_objects", "estimate_depth"], "answer_regex": "\\d+(\\.\\d+)?\\s*(m\\b|meter|metre)"}}
{"id": "bus-describe", "media": "sample:seoul/street_bus.jpg", "question": "Describe this scene in one sentence.", "expect": {"tools_all": ["describe_image"], "answer_contains_any": ["bus"]}}
{"id": "bus-standing", "media": "sample:seoul/street_bus.jpg", "question": "How many people are standing?", "expect": {"tools_all": ["estimate_pose"], "answer_number": {"min": 2, "max": 4}}}
{"id": "bus-coverage", "media": "sample:seoul/street_bus.jpg", "question": "Outline the bus and tell me roughly how much of the image it covers.", "expect": {"tools_all": ["segment_objects"], "answer_regex": "\\d+(\\.\\d+)?\\s*%"}}
{"id": "bus-position", "media": "sample:seoul/street_bus.jpg", "question": "Is the bus in the top, middle or bottom part of the image?", "expect": {"tools_any": ["detect_objects", "find_phrase", "segment_objects"], "answer_contains_any": ["middle", "center", "centre"]}}
{"id": "bus-objects", "media": "sample:seoul/street_bus.jpg", "question": "List the objects you can find in this picture.", "expect": {"tools_any": ["detect_objects", "segment_objects"], "answer_contains_all": ["bus"], "answer_contains_any": ["person", "people"]}}
{"id": "bus-sign", "media": "sample:seoul/street_bus.jpg", "question": "Find any sign or signboard in the picture.", "expect": {"tools_any": ["find_phrase"], "answer_contains_any": ["sign"]}}
{"id": "bus-separate", "media": "sample:seoul/street_bus.jpg", "question": "Count the people and the vehicles separately.", "expect": {"tools_all": ["detect_objects"], "answer_contains_all": ["4"], "answer_contains_any": ["bus", "vehicle"]}}
{"id": "bus-depth-range", "media": "sample:seoul/street_bus.jpg", "question": "What is the depth range of this scene in meters?", "expect": {"tools_all": ["estimate_depth"], "answer_regex": "\\d+(\\.\\d+)?\\s*(m\\b|meter|metre)"}}
{"id": "menu-read", "media": "sample:seoul/korean_menu.jpg", "question": "Read the Korean text on this menu.", "expect": {"tools_all": ["read_korean_text"], "answer_contains_all": ["칼국수"]}}
{"id": "menu-translate", "media": "sample:seoul/korean_menu.jpg", "question": "Translate this menu into English.", "expect": {"tools_all": ["read_korean_text"], "answer_contains_any": ["noodle"]}}
{"id": "menu-cheapest", "media": "sample:seoul/korean_menu.jpg", "question": "What is the cheapest item and how much is it?", "expect": {"tools_all": ["read_korean_text"], "answer_contains_any": ["5,000", "5000"]}}
{"id": "menu-perilla", "media": "sample:seoul/korean_menu.jpg", "question": "How much is the perilla seed noodle soup?", "expect": {"tools_all": ["read_korean_text"], "answer_contains_any": ["9,500", "9500"]}}
{"id": "menu-hours", "media": "sample:seoul/korean_menu.jpg", "question": "What are the opening hours?", "expect": {"tools_all": ["read_korean_text"], "answer_contains_all": ["11"], "answer_contains_any": ["21", "9 PM", "9 pm", "9pm", "9:00 PM", "9:00 pm"]}}
{"id": "menu-closed", "media": "sample:seoul/korean_menu.jpg", "question": "Which day of the week is the shop closed?", "expect": {"tools_all": ["read_korean_text"], "answer_contains_any": ["Monday", "월요일"]}}
{"id": "menu-name", "media": "sample:seoul/korean_menu.jpg", "question": "What is the name of the restaurant?", "expect": {"tools_all": ["read_korean_text"], "answer_contains_any": ["공릉", "Gongneung"]}}
{"id": "menu-dumplings", "media": "sample:seoul/korean_menu.jpg", "question": "How many dumplings come in one order?", "expect": {"tools_all": ["read_korean_text"], "answer_number": {"min": 6, "max": 6}}}
{"id": "menu-what", "media": "sample:seoul/korean_menu.jpg", "question": "Is this a menu or a street sign? Explain briefly.", "expect": {"tools_any": ["describe_image", "read_korean_text"], "answer_contains_any": ["menu"]}}
